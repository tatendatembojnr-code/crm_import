<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View Extension -->
    <record id="crm_lead_view_form_inherit_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="attributes">
                <attribute name="js_class">crm_lead_form</attribute>
            </xpath>

            <!-- Add Quick Response Buttons to Header -->
            <xpath expr="//header" position="inside">
                <button name="action_set_response_no_answer" type="object" string="No Answer" class="btn-secondary" invisible="not active or probability == 0"/>
                <button name="action_set_response_not_reachable" type="object" string="Not Reachable" class="btn-secondary" invisible="not active or probability == 0"/>
                <button name="action_set_response_no_first_call" type="object" string="No Answer (1st Call)" class="btn-secondary" invisible="not active or probability == 0"/>
            </xpath>

            <!-- Replace the main oe_title with a clean Notebook containing Lead tab -->
            <xpath expr="//div[hasclass('oe_title')]" position="replace">
                <notebook>
                    <!-- Main Lead Info Tab -->
                    <page name="lead_page" string="Lead">
                        <!-- Standard oe_title -->
                        <div class="oe_title mw-100">
                            <div class="d-flex justify-content-between align-items-center">
                                <h1 class="flex-grow-1">
                                    <field class="text-break" options="{'line_breaks': False}" widget="text" name="name" placeholder="e.g. Product Pricing"/>
                                </h1>
                            </div>
                            <h2 class="row g-0 pb-3 pb-sm-4">
                                <div class="col-auto pb-2 pb-md-0 w-100 w-sm-auto" invisible="type == 'lead'">
                                    <label for="expected_revenue" class="oe_edit_only"/>
                                    <div class="d-flex flex-wrap align-items-baseline">
                                        <field name="company_currency" invisible="1"/>
                                        <field name="expected_revenue" class="o_input_13ch" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <div id="probability" class="d-flex align-items-baseline">
                                        <field name="is_automated_probability" invisible="1"/>
                                        <field name="probability" widget="float" class="oe_inline o_input_6ch" readonly="won_status != 'pending'"/>
                                        <span class="opacity-50 p-2"> %</span>
                                    </div>
                                </div>
                            </h2>
                        </div>

                        <!-- Unified 3-column details -->
                        <group col="3">
                            <!-- Column 1: Contact & Basic Info -->
                            <group string="Contact &amp; Basic Info">
                                <field name="partner_id" string="Customer" widget="res_partner_many2one"/>
                                <field name="contact_name" string="Contact / First Name"/>
                                <field name="partner_name" string="Organization/Store Name"/>
                                <field name="email_from" string="Email"/>
                                <field name="phone" string="Phone"/>
                                <field name="website" string="Website"/>
                                <field name="source_id" string="Source"/>
                                <field name="crm_product_id" string="Product Interest" options="{'no_create': True}" required="1" />
                            </group>
                            
                            <!-- Column 2: Deal & Sales Info -->
                            <group string="Deal &amp; Sales Info">
                                <field name="user_id" string="Salesperson" domain="[('share', '=', False), ('active', '=', True)]"/>
                                <field name="team_id" string="Sales Team"/>
                                <field name="priority" widget="priority"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                                <field name="last_chatter" string="Last Chatter" readonly="1"/>
                                <field name="custom_next_contact_date" string="Next Contact Date"/>
                                <field name="custom_response_status" string="Response Status"/>
                                <field name="custom_deal_size" string="Deal Size $"/>
                                <field name="custom_quote" string="Quote"/>
                                <field name="custom_quote_date" string="Quote Date"/>
                                <field name="custom_proposal_status" string="Proposal"/>
                                <field name="custom_proposal_date" string="Proposal Date"/>
                            </group>

                            <!-- Column 3: Address & Additional Info -->
                            <group string="Address &amp; Additional Info">
                                <field name="city" string="City/Town"/>
                                <field name="street" string="Full Address"/>
                                <field name="custom_technician" string="Technician"/>
                                <field name="custom_type_of_business" string="Type of Business"/>
                                <field name="custom_demo_done" string="Demo Done"/>
                                <field name="custom_demo_type" string="Demo Done Online/Onsite" invisible="custom_demo_done != 'yes'"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>

            <!-- Hide the standard Odoo 2-column top group to prevent duplicate layout -->
            <xpath expr="//sheet/group" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide the extra information tab to keep the UI clean and prevent repetition -->
            <xpath expr="//page[@name='extra']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide the standard bottom notebook so there are no duplicate notebooks on the form -->
            <xpath expr="//notebook[page[@name='internal_notes']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <!-- Tree / List View Extension to show Last Chatter, Deadline & Product Interest -->
    <record id="crm_lead_view_tree_inherit_custom" model="ir.ui.view">
        <field name="name">crm.lead.tree.inherit.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">write_date desc, id desc</attribute>
                <attribute name="limit">1000</attribute>
            </xpath>
            <xpath expr="//field[@name='create_date']" position="after">
                <field name="write_date" string="Updated On" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='country_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='email_from']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="custom_response_status" string="Response Status" optional="hide"/>
                <field name="custom_next_contact_date" string="Next Contact Date" optional="show"/>
                <field name="last_chatter" string="Last Chatter" optional="show"/>
                <field name="my_activity_date_deadline" string="Activity Deadline" widget="remaining_days" optional="show"/>
                <field name="date_deadline" string="Expected Closing" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Clean Opportunities Tree / List View (Free of inline action buttons) -->
    <record id="crm_lead_view_tree_pipeline_custom" model="ir.ui.view">
        <field name="name">crm.lead.tree.pipeline.custom</field>
        <field name="model">crm.lead</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Opportunities" sample="1" multi_edit="1" decoration-muted="won_status == 'lost'" default_order="write_date desc, id desc" limit="1000">
                <header>
                    <button name="%(crm.crm_lead_lost_action)d" type="action" string="Mark Lost"/>
                    <button name="%(crm.action_lead_mass_mail)d" type="action" string="Email"/>
                </header>
                <field name="company_id" column_invisible="True"/>
                <field name="user_company_ids" column_invisible="True"/>
                <field name="date_deadline" column_invisible="True"/>
                <field name="activity_calendar_event_id" column_invisible="True"/>
                <field name="won_status" column_invisible="True"/>
                <field name="create_date" optional="hide"/>
                <field name="write_date" string="Updated On" optional="hide"/>
                <field name="create_uid" string="Created By" optional="hide"/>
                <field name="name" string="Opportunity" readonly="1" optional="hide"/>
                <field name="crm_product_id" string="Product Interest" column_invisible="True"/>
                <field name="partner_id" optional="hide" string="Contact"/>
                <field name="contact_name" optional="hide" string="Contact Name"/>
                <field name="email_from" optional="hide" string="Email"/>
                <field name="phone" optional="show" class="o_force_ltr"/>
                <field name="city" optional="hide"/>
                <field name="state_id" optional="hide"/>
                <field name="country_id" optional="hide" options="{'no_open': True, 'no_create': True}"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show" domain="[('share', '=', False), ('active', '=', True)]"/>
                <field name="team_id" optional="hide"/>
                <field name="priority" optional="hide" widget="priority"/>
                <field name="last_chatter" string="Activities" optional="show"/>
                <field name="custom_response_status" string="Response Status" optional="hide"/>
                <field name="custom_next_contact_date" string="Next Contact Date" optional="show"/>
                <field name="activity_user_id" optional="hide" string="Activity by" widget="many2one_avatar_user"/>
                <field name="my_activity_date_deadline" optional="hide" string="My Deadline" widget="remaining_days" options="{'allow_order': '1'}"/>
                <field name="campaign_id" optional="hide"/>
                <field name="medium_id" optional="hide"/>
                <field name="source_id" optional="hide"/>
                <field name="company_currency" column_invisible="True"/>
                <field name="expected_revenue" sum="Expected Revenues" optional="show" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                <field name="stage_id_color" column_invisible="1"/>
                <field name="stage_id" optional="show" widget="badge_rotting" options="{'no_open': True}" string="Stage"/>
                <field name="active" column_invisible="True"/>
                <field name="probability" string="Probability (%)" optional="hide"/>
                <field name="lost_reason_id" optional="hide"/>
                <field name="tag_ids" optional="hide" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="referred" column_invisible="True"/>
                <field name="message_needaction" column_invisible="True"/>
                <field name="lead_properties"/>
                <field name="is_rotting" column_invisible="True"/>
                <field name="rotting_days" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Inherit Search Filter for Opportunities: Add Deadline, Created By & Creation Date Filters -->
    <record id="crm_lead_view_search_inherit_custom_deadlines" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.custom.deadlines</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="create_uid" string="Created By"/>
            </xpath>
            <xpath expr="//filter[@name='assigned_to_me']" position="after">
                <separator/>
                <!-- User Assignment & Creator Filters -->
                <filter string="Created by Me" name="created_by_me" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <!-- Creation Date Filters -->
                <filter string="Created: Today" name="created_today"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('create_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Created: Yesterday" name="created_yesterday"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')),
                                 ('create_date', '&lt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Created: Last 7 Days" name="created_last_7_days"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Created: Last 2 Weeks (14 Days)" name="created_last_14_days"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=14)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Created: Last 21 Days" name="created_last_21_days"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=21)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Created: Last Month (30 Days)" name="created_last_month"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Creation Date (Date Drilldown)" name="filter_create_date_drilldown" date="create_date"/>
                <separator/>
                <!-- Response Status Filters -->
                <filter string="Response: Normal" name="resp_normal" domain="[('custom_response_status', '=', 'normal')]"/>
                <filter string="Response: No Answer" name="resp_no_answer" domain="[('custom_response_status', '=', 'no_answer')]"/>
                <filter string="Response: Not Reachable" name="resp_not_reachable" domain="[('custom_response_status', '=', 'not_reachable')]"/>
                <filter string="Response: No Answer (1st Call)" name="resp_no_first_call" domain="[('custom_response_status', '=', 'no_first_call')]"/>
                <separator/>
                <!-- User Deadline Filters -->
                <filter string="My Deadline: Today" name="my_deadline_today"
                        domain="[('my_activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="My Deadline: This Week" name="my_deadline_this_week"
                        domain="[('my_activity_date_deadline', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                                 ('my_activity_date_deadline', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="My Deadline: This Month" name="my_deadline_this_month"
                        domain="[('my_activity_date_deadline', '&gt;=', context_today().strftime('%Y-%m-01')),
                                 ('my_activity_date_deadline', '&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>
                <filter string="My Deadline: This Year" name="my_deadline_this_year"
                        domain="[('my_activity_date_deadline', '&gt;=', context_today().strftime('%Y-01-01')),
                                 ('my_activity_date_deadline', '&lt;=', context_today().strftime('%Y-12-31'))]"/>
                <separator/>
                <!-- Global / Admin Deadline Filters -->
                <filter string="Deadline: Today" name="deadline_today"
                        domain="[('activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Deadline: This Week" name="deadline_this_week"
                        domain="[('activity_date_deadline', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                                 ('activity_date_deadline', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="Deadline: This Month" name="deadline_this_month"
                        domain="[('activity_date_deadline', '&gt;=', context_today().strftime('%Y-%m-01')),
                                 ('activity_date_deadline', '&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Expected Closing (Date Drilldown)" name="filter_date_deadline" date="date_deadline"/>
                <separator/>
                <!-- Update Date Filters -->
                <filter string="Updated: Today" name="updated_today"
                        domain="[('write_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('write_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Updated: Yesterday" name="updated_yesterday"
                        domain="[('write_date', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')),
                                 ('write_date', '&lt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Updated: Last Hour" name="updated_last_hour"
                        domain="[('write_date', '&gt;=', (datetime.datetime.now() - datetime.timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter string="Updated: Last Week (7 Days)" name="updated_last_week"
                        domain="[('write_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Updated: Last Month (30 Days)" name="updated_last_month"
                        domain="[('write_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Updated: Last Year (365 Days)" name="updated_last_year"
                        domain="[('write_date', '&gt;=', (context_today() - datetime.timedelta(days=365)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Updated On (Date Drilldown)" name="filter_write_date_drilldown" date="write_date"/>
                <separator/>
                <!-- Overdue Filters (Starting from today going back - Indexed High Speed) -->
                <filter string="Overdue (Today &amp; Past)" name="overdue_today_past"
                        domain="[('activity_ids.date_deadline', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="My Overdue (Today &amp; Past)" name="my_overdue_today_past"
                        domain="[('activity_ids.date_deadline', '&lt;=', context_today().strftime('%Y-%m-%d')), ('activity_ids.user_id', '=', uid)]"/>
                <filter string="Overdue: Past Only (&lt; Today)" name="overdue_strictly_past"
                        domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Overdue: Today" name="overdue_today"
                        domain="[('activity_ids.date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Overdue: Yesterday" name="overdue_yesterday"
                        domain="[('activity_ids.date_deadline', '=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Overdue: Last 7 Days" name="overdue_last_7_days"
                        domain="[('activity_ids.date_deadline', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d')),
                                 ('activity_ids.date_deadline', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Overdue: Last 30 Days" name="overdue_last_30_days"
                        domain="[('activity_ids.date_deadline', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d')),
                                 ('activity_ids.date_deadline', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Overdue Next Contact Date" name="overdue_next_contact"
                        domain="[('custom_next_contact_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Created By" name="group_by_create_uid" context="{'group_by': 'create_uid'}"/>
                <filter string="Salesperson" name="group_by_salesperson" context="{'group_by': 'user_id'}"/>
                <filter string="Response Status" name="group_by_response_status" context="{'group_by': 'custom_response_status'}"/>
                <filter string="Updated By" name="group_by_write_uid" context="{'group_by': 'write_uid'}"/>
                <filter string="Creation Date: Day (Latest First)" name="group_by_create_date_day_desc" context="{'group_by':'create_date:day', 'orderedBy': [{'name': 'create_date', 'asc': False}]}"/>
                <filter string="Creation Date: Month (Latest First)" name="group_by_create_date_month_desc" context="{'group_by':'create_date:month', 'orderedBy': [{'name': 'create_date', 'asc': False}]}"/>
                <filter string="Update Date: Day (Latest First)" name="group_by_write_date_day_desc" context="{'group_by':'write_date:day', 'orderedBy': [{'name': 'write_date', 'asc': False}]}"/>
                <filter string="Update Date: Month (Latest First)" name="group_by_write_date_month_desc" context="{'group_by':'write_date:month', 'orderedBy': [{'name': 'write_date', 'asc': False}]}"/>
            </xpath>
        </field>
    </record>

    <!-- Dedicated Tree / List View for 'Updated On' -->
    <record id="crm_lead_view_tree_updated_on" model="ir.ui.view">
        <field name="name">crm.lead.tree.updated.on</field>
        <field name="model">crm.lead</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Updated Opportunities" sample="1" multi_edit="1" default_order="write_date desc, id desc">
                <header>
                    <button name="%(crm.crm_lead_lost_action)d" type="action" string="Mark Lost"/>
                    <button name="%(crm.action_lead_mass_mail)d" type="action" string="Email"/>
                </header>
                <field name="priority" optional="show" widget="priority"/>
                <field name="name" string="Opportunity" readonly="1"/>
                <field name="contact_name" optional="show" string="Contact"/>
                <field name="partner_name" optional="show" string="Organization"/>
                <field name="phone" optional="show" class="o_force_ltr"/>
                <field name="crm_product_id" string="Product Interest" column_invisible="True"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show" domain="[('share', '=', False), ('active', '=', True)]"/>
                <field name="custom_response_status" string="Response Status" optional="show"/>
                <field name="custom_next_contact_date" string="Next Contact Date" optional="show"/>
                <field name="write_date" string="Updated On" optional="show"/>
                <field name="write_uid" string="Updated By" widget="many2one_avatar_user" optional="show"/>
                <field name="last_chatter" string="Activities / Notes" optional="show"/>
                <field name="stage_id" optional="show" widget="badge_rotting" string="Stage"/>
                <field name="expected_revenue" sum="Expected Revenues" optional="show" widget="monetary"/>
                <field name="create_date" string="Created On" optional="hide"/>
                <field name="create_uid" string="Created By" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Dedicated Tree / List View for 'Overdue' -->
    <record id="crm_lead_view_tree_overdue" model="ir.ui.view">
        <field name="name">crm.lead.tree.overdue</field>
        <field name="model">crm.lead</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Overdue Leads" sample="1" multi_edit="1" default_order="priority desc, create_date desc, id desc">
                <header>
                    <button name="%(crm.crm_lead_lost_action)d" type="action" string="Mark Lost"/>
                    <button name="%(crm.action_lead_mass_mail)d" type="action" string="Email"/>
                </header>
                <field name="priority" optional="show" widget="priority"/>
                <field name="name" string="Opportunity" readonly="1"/>
                <field name="contact_name" optional="show" string="Contact"/>
                <field name="partner_name" optional="show" string="Organization"/>
                <field name="phone" optional="show" class="o_force_ltr"/>
                <field name="crm_product_id" string="Product Interest" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show" domain="[('share', '=', False), ('active', '=', True)]"/>
                <field name="activity_date_deadline" string="Activity Deadline" widget="remaining_days" optional="show"/>
                <field name="my_activity_date_deadline" string="My Deadline" widget="remaining_days" optional="hide"/>
                <field name="custom_next_contact_date" string="Next Contact Date" optional="show"/>
                <field name="custom_response_status" string="Response Status" optional="show"/>
                <field name="last_chatter" string="Activities / Notes" optional="show"/>
                <field name="stage_id" optional="show" widget="badge_rotting" string="Stage"/>
                <field name="expected_revenue" sum="Expected Revenues" optional="show" widget="monetary"/>
                <field name="write_date" string="Updated On" optional="hide"/>
                <field name="create_date" string="Created On" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Default Pipeline Actions to List View with Auto-Filters and Limit 1000 -->
    <record id="crm.crm_lead_action_pipeline" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,graph,pivot,calendar,activity,form</field>
        <field name="limit">1000</field>
        <field name="context">{
            'default_type': 'opportunity',
            'show_user_team_stages': 1,
            'search_default_deadline_today': 1 if uid in (1, 2) else 0,
            'search_default_my_deadline_today': 1 if uid not in (1, 2) else 0,
        }</field>
    </record>

    <record id="crm.crm_lead_opportunities" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,graph,pivot,calendar,activity,form</field>
        <field name="limit">1000</field>
        <field name="context">{
            'default_type': 'opportunity',
            'search_default_deadline_today': 1 if uid in (1, 2) else 0,
            'search_default_my_deadline_today': 1 if uid not in (1, 2) else 0,
        }</field>
    </record>

    <record id="crm.crm_lead_action_pipeline_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm_lead_view_tree_pipeline_custom"/>
        <field name="act_window_id" ref="crm.crm_lead_action_pipeline"/>
    </record>

    <record id="crm.crm_lead_action_pipeline_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="act_window_id" ref="crm.crm_lead_action_pipeline"/>
    </record>

    <!-- Window Action: Updated On (Default: Updated Today) -->
    <record id="action_crm_lead_updated_on" model="ir.actions.act_window">
        <field name="name">Updated On</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,graph,pivot,calendar,activity,form</field>
        <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="view_id" ref="crm_lead_view_tree_updated_on"/>
        <field name="context">{
            'default_type': 'lead',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Leads &amp; Opportunities Updated Today
            </p>
            <p>
                Track leads and opportunities by when they were recently edited or updated.
            </p>
        </field>
    </record>

    <record id="action_crm_lead_updated_on_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm_lead_view_tree_updated_on"/>
        <field name="act_window_id" ref="action_crm_lead_updated_on"/>
    </record>

    <!-- Window Action: Overdue (Default: Overdue Today & Past) -->
    <record id="action_crm_lead_overdue" model="ir.actions.act_window">
        <field name="name">Overdue</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,graph,pivot,calendar,activity,form</field>
        <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="view_id" ref="crm_lead_view_tree_overdue"/>
        <field name="context">{
            'default_type': 'opportunity',
            'search_default_overdue_today_past': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Overdue Leads &amp; Opportunities
            </p>
            <p>
                Follow up on opportunities with deadlines scheduled for today or earlier in the past.
            </p>
        </field>
    </record>

    <record id="action_crm_lead_overdue_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm_lead_view_tree_overdue"/>
        <field name="act_window_id" ref="action_crm_lead_overdue"/>
    </record>

    <!-- Top CRM Menu Items for Updated On and Overdue -->
    <menuitem id="menu_crm_lead_updated_on"
