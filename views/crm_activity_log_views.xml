<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View for Activity Log: 1 Row per Salesperson -->
    <record id="crm_activity_log_view_tree" model="ir.ui.view">
        <field name="name">crm.activity.log.list</field>
        <field name="model">crm.activity.log</field>
        <field name="arch" type="xml">
            <list string="Activity Log" default_order="total_count desc, new_leads_count desc" create="0" delete="0" edit="0">
                <field name="user_id" widget="many2one_avatar_user" string="Salesperson"/>
                <field name="new_leads_count" string="New Leads" sum="Total New Leads"/>
                <field name="updated_leads_count" string="Updated Leads" sum="Total Updated Leads"/>
                <field name="total_count" string="Total" sum="Grand Total"/>
            </list>
        </field>
    </record>

    <!-- Search View for Activity Log -->
    <record id="crm_activity_log_view_search" model="ir.ui.view">
        <field name="name">crm.activity.log.search</field>
        <field name="model">crm.activity.log</field>
        <field name="arch" type="xml">
            <search string="Search Activity Log">
                <field name="user_id" string="Salesperson"/>
                <separator/>
                <filter string="My Activities" name="my_activities"
                        domain="[('user_id', '=', uid)]"/>
            </search>
        </field>
    </record>

    <!-- Window Action for Activity Log -->
    <record id="action_crm_activity_log" model="ir.actions.act_window">
        <field name="name">Activity Log</field>
        <field name="res_model">crm.activity.log</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm_activity_log_view_tree"/>
        <field name="search_view_id" ref="crm_activity_log_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Salesperson Activity Log
            </p>
            <p>
                Overview of newly created and updated leads per salesperson.
            </p>
        </field>
    </record>

    <!-- Top CRM Menu Item for Activity Log -->
    <menuitem id="crm_menu_activity_log"
              name="Activity Log"
              parent="crm.crm_menu_root"
              action="action_crm_activity_log"
              sequence="4"/>
</odoo>
