<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View for Hourly Activity Log -->
    <record id="crm_hourly_activity_log_view_tree" model="ir.ui.view">
        <field name="name">crm.hourly.activity.log.list</field>
        <field name="model">crm.hourly.activity.log</field>
        <field name="arch" type="xml">
            <list string="Hourly Activity Log" default_order="activity_date desc, total_count desc" create="0" delete="0" edit="0">
                <field name="activity_date" string="Date" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" string="Salesperson"/>
                <field name="h08_09" string="8am to 9am" sum="Total 8am-9am"/>
                <field name="h09_10" string="9am to 10am" sum="Total 9am-10am"/>
                <field name="h10_11" string="10am to 11am" sum="Total 10am-11am"/>
                <field name="h11_12" string="11am to 12pm" sum="Total 11am-12pm"/>
                <field name="h12_01" string="12pm to 1pm" sum="Total 12pm-1pm"/>
                <field name="h02_03" string="2pm to 3pm" sum="Total 2pm-3pm"/>
                <field name="h03_04" string="3pm to 4pm" sum="Total 3pm-4pm"/>
                <field name="h04_05" string="4pm to 5pm" sum="Total 4pm-5pm"/>
                <field name="total_count" string="Total" sum="Grand Total"/>
            </list>
        </field>
    </record>

    <!-- Search View for Hourly Activity Log with Seeded Filters -->
    <record id="crm_hourly_activity_log_view_search" model="ir.ui.view">
        <field name="name">crm.hourly.activity.log.search</field>
        <field name="model">crm.hourly.activity.log</field>
        <field name="arch" type="xml">
            <search string="Search Hourly Activity Log">
                <field name="user_id" string="Salesperson"/>
                <field name="activity_date" string="Date"/>
                <separator/>
                <filter string="My Activities" name="my_activities" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <!-- Activity Date Filters -->
                <filter string="Today" name="today" domain="[('activity_date', '=', 'today')]"/>
                <filter string="Yesterday" name="yesterday" domain="[('activity_date', '=', 'today -1d')]"/>
                <filter string="Last 7 Days" name="last_7_days" domain="[('activity_date', '&gt;=', 'today -7d')]"/>
                <filter string="Last 2 Weeks (14 Days)" name="last_14_days" domain="[('activity_date', '&gt;=', 'today -14d')]"/>
                <filter string="Last 21 Days" name="last_21_days" domain="[('activity_date', '&gt;=', 'today -21d')]"/>
                <filter string="Last Month (30 Days)" name="last_month" domain="[('activity_date', '&gt;=', 'today -30d')]"/>
                <filter string="This Month" name="this_month" domain="[('activity_date', '&gt;=', '=month_start'), ('activity_date', '&lt;', '=month_start +1m')]"/>
                <filter string="This Year" name="this_year" domain="[('activity_date', '&gt;=', '=year_start'), ('activity_date', '&lt;', '=year_start +1y')]"/>
                <filter string="Activity Date (Date Drilldown)" name="filter_activity_date_drilldown" date="activity_date"/>
                <separator/>
                <group>
                    <filter string="Salesperson" name="group_by_salesperson" context="{'group_by': 'user_id'}"/>
                    <filter string="Activity Date: Day (Latest First)" name="group_by_activity_date_day_desc" context="{'group_by':'activity_date:day', 'orderedBy': [{'name': 'activity_date', 'asc': False}]}"/>
                    <filter string="Activity Date: Month (Latest First)" name="group_by_activity_date_month_desc" context="{'group_by':'activity_date:month', 'orderedBy': [{'name': 'activity_date', 'asc': False}]}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action for Hourly Activity Log (Defaults to Today) -->
    <record id="action_crm_hourly_activity_log" model="ir.actions.act_window">
        <field name="name">Hourly Activity Log</field>
        <field name="res_model">crm.hourly.activity.log</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm_hourly_activity_log_view_tree"/>
        <field name="search_view_id" ref="crm_hourly_activity_log_view_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Hourly Activity Log
            </p>
            <p>
                Hourly timetable overview of leads, to-dos, and activities completed per salesperson.
            </p>
        </field>
    </record>

    <!-- Top CRM Menu Item for Hourly Activity Log -->
    <menuitem id="crm_menu_hourly_activity_log"
              name="Hourly Activity Log"
              parent="crm.crm_menu_root"
              action="action_crm_hourly_activity_log"
              sequence="5"/>
</odoo>
